# Copy this file to .env and fill in real values before running.

APP_NAME="SDP Internal Performance & Workflow Management System"
ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Security ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_super_secret_key_please_rotate
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database: Supabase Postgres connection string ---
# Get this from Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Paste it exactly as Supabase gives it (postgresql:// is fine) — the app
# auto-converts the scheme to the async driver it needs at startup.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Redis (optional; only used for rate limiting scale-out) ---
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# --- CORS: comma-separated list of allowed frontend origins ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Supabase (optional; only needed if you later wire up Supabase Storage/Auth) ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
